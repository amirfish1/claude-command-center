# Hardened-deployment credentials for docker-compose.hardened.yml.
#
#   cp .env.hardened.example .env.hardened
#   # then fill in the values below and keep .env.hardened OUT of git.
#
# Generate the bcrypt hash (do NOT put the plaintext password in this file):
#   docker run --rm caddy caddy hash-password --plaintext 'your-strong-password'
#
# Paste the resulting $2a$... string as CCC_BASIC_AUTH_HASH. Because compose
# performs ${} variable expansion on this file, every literal `$` in the hash
# MUST be doubled to `$$` or the hash will be mangled. Example:
#   real hash : $2a$14$abc...
#   in here   : $$2a$$14$$abc...

CCC_BASIC_AUTH_USER=admin
CCC_BASIC_AUTH_HASH=REPLACE_WITH_DOUBLED_DOLLAR_BCRYPT_HASH
