[Unit]
Description=Claude Command Center persistent execution worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=__CCC_HOME__/Apps/claude-command-center

Environment=HOME=__CCC_HOME__
Environment=PATH=__CCC_HOME__/.local/bin:__CCC_HOME__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=LANG=en_US.UTF-8

ExecStart=/usr/bin/python3 __CCC_HOME__/Apps/claude-command-center/ccc_worker.py

Restart=always
RestartSec=2s

# Use KillMode=process so worker restarts signal the worker process only
KillMode=process

# --- Blast-radius containment ---
MemoryHigh=24G
MemoryMax=32G
MemorySwapMax=0

LimitNOFILE=4096

StandardOutput=append:__CCC_HOME__/.claude/command-center/logs/vm-worker.out.log
StandardError=append:__CCC_HOME__/.claude/command-center/logs/vm-worker.err.log

[Install]
WantedBy=multi-user.target
