# Caddyfile — TLS + HTTP Basic auth in front of Claude Command Center.
#
# Caddy is the only reachable surface in the hardened stack. It:
#   - Terminates TLS on :8443 using a locally-generated cert (Caddy's own
#     internal CA — no public ACME, since this is localhost/private).
#   - Requires HTTP Basic auth before proxying anything to CCC.
#   - Forwards authenticated traffic to the `ccc` service on the internal
#     Docker network, which is not reachable from the host or LAN directly.
#
# The username + bcrypt hash come from the environment (set in
# .env.hardened): CCC_BASIC_AUTH_USER and CCC_BASIC_AUTH_HASH. Generate a
# hash with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-password'
{
	# Quiet, predictable admin surface: disable the admin API (we don't
	# drive Caddy at runtime) so it isn't listening inside the container.
	admin off
	# Use Caddy's internal CA for the local/self-signed cert.
	# No outbound ACME calls for a localhost deployment.
	local_certs
	# Which hostname's internal cert to present when a client connects
	# without SNI (e.g. by raw IP). Must match a subject below.
	default_sni localhost
}

# Serve on :8443 for the local hostnames + loopback IPs. Listing explicit
# subjects (rather than a bare `:8443`) makes Caddy's internal CA mint a cert
# whose SAN covers localhost / 127.0.0.1 / ::1, so the TLS handshake succeeds
# whether the client connects by name or by IP. Add your tailnet/LAN hostname
# here if you reach the dashboard under a different name.
https://localhost:8443, https://127.0.0.1:8443, https://[::1]:8443 {
	tls internal

	# ---- Authentication gate -------------------------------------------
	# Every request must carry valid Basic credentials. Caddy compares
	# against the bcrypt hash; no plaintext password is stored anywhere.
	basic_auth {
		{$CCC_BASIC_AUTH_USER} {$CCC_BASIC_AUTH_HASH}
	}

	# ---- Reverse proxy to CCC ------------------------------------------
	# Only reached AFTER auth passes. `ccc` resolves on the internal Docker
	# network to the CCC container; :8090 is its in-container listen port.
	reverse_proxy ccc:8090 {
		# CCC ingests Server-Sent Events (/api/sessions/events and the live
		# transcript stream). Disable response buffering so SSE flushes
		# through the proxy in real time instead of being held.
		flush_interval -1

		# Note: Caddy forwards X-Forwarded-Host / -Proto to the upstream by
		# default, so no explicit header_up directives are needed here.
	}

	# Reasonable security headers for a browser-facing dashboard.
	header {
		# Don't leak the proxied server details.
		-Server
		# HSTS is intentionally NOT set: this uses a self-signed local cert,
		# and pinning HTTPS-only via HSTS on localhost can wedge other local
		# services sharing the hostname. Add it only for a real domain+cert.
	}
}
