{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "CCC app catalog",
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "permissions",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$",
            "not": {
              "enum": [
                "allowances",
                "decision-guide",
                "decision-inbox",
                "morning",
                "pipeline-canvas",
                "queues",
                "savings",
                "sessions",
                "spawn-ledger"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "sessions.read",
                "queues.read"
              ]
            },
            "uniqueItems": true,
            "maxItems": 2
          },
          "source": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^(examples/apps/[a-z0-9_-]{1,40}|https://[^\\s\\\\@#]+)$"
          }
        }
      }
    }
  }
}
