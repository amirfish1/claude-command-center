# ccc vault — local secrets (ccc_server/vault.py). Reads the Keychain /
# encrypted file directly: the server's HTTP API is write-only, so values
# never travel over HTTP. Needs no running server.
# ---------------------------------------------------------------------------

def _vault_module():
    repo_dir = os.path.dirname(os.path.realpath(__file__))
    if repo_dir not in sys.path:
        sys.path.append(repo_dir)
    from ccc_server import vault
    return vault


def _vault_fmt_ts(ts):
    if not ts:
        return "-"
    try:
        return datetime.fromtimestamp(float(ts)).strftime("%Y-%m-%d %H:%M")
    except (TypeError, ValueError, OSError):
        return "-"


def cmd_vault_list(args):
    vault = _vault_module()
    rows = [
        {k: e.get(k) or "" for k in ("name", "kind", "service", "username", "env_var")}
        | {"updated_at": e.get("value_updated_at") or e.get("updated_at")}
        for e in vault.vault_list_entries()
    ]
    if args.json:
        print(json.dumps({"backend": vault.vault_storage_backend(), "entries": rows}, indent=2))
        return 0
    if not rows:
        print("(vault is empty — add entries in Settings > Vault)", file=sys.stderr)
        return 0
    headers = ("NAME", "KIND", "SERVICE", "USERNAME", "ENV VAR", "VALUE UPDATED")
    table = [(r["name"], r["kind"], r["service"], r["username"], r["env_var"],
              _vault_fmt_ts(r["updated_at"])) for r in rows]
    widths = [max(len(h), *(len(str(row[i])) for row in table)) for i, h in enumerate(headers)]
    print("  ".join(h.ljust(w) for h, w in zip(headers, widths)).rstrip())
    for row in table:
        print("  ".join(str(c).ljust(w) for c, w in zip(row, widths)).rstrip())
    return 0


def cmd_vault_get(args):
    vault = _vault_module()
    entry = vault.vault_get_entry(args.name)
    if not entry:
        print(f"ccc vault: no entry named {args.name!r} (see `ccc vault list`)", file=sys.stderr)
        return 1
    value = vault.vault_get_value(args.name)
    if not value:
        print(f"ccc vault: {entry['name']!r} is listed but its value is missing from "
              f"{vault.vault_storage_backend()}", file=sys.stderr)
        return 1
    if args.reveal:
        sys.stdout.write(value + ("\n" if sys.stdout.isatty() else ""))
        sys.stdout.flush()
        return 0
    bits = [entry.get("kind") or "", entry.get("service") or ""]
    if entry.get("env_var"):
        bits.append("env " + entry["env_var"])
    desc = ", ".join(b for b in bits if b)
    print(f"{entry['name']}: saved ({desc}); updated "
          f"{_vault_fmt_ts(entry.get('value_updated_at') or entry.get('updated_at'))}. "
          "Use `ccc vault exec` to use it, or --reveal to print it.")
    return 0


def _vault_redaction_pairs(secrets):
    """[(needle_bytes, replacement_bytes)] longest first. ``secrets`` is
    [(label, value)]. Multi-line values also redact each substantial line,
    since a tool may print a PEM key line by line."""
    pairs = {}
    for label, value in secrets:
        rep = f"[REDACTED:{label}]".encode("utf-8")
        needles = {value}
        if "\n" in value:
            needles |= {ln.strip() for ln in value.splitlines() if len(ln.strip()) >= 8}
        for needle in needles:
            if needle:
                pairs.setdefault(needle.encode("utf-8"), rep)
    return sorted(pairs.items(), key=lambda kv: -len(kv[0]))


def _vault_redact(data, pairs):
    for needle, rep in pairs:
        data = data.replace(needle, rep)
    return data


class _VaultRedactingPump:
    """Copy a child's pipe to ``out`` with secret values replaced.

    Chunked, not line-buffered, so prompts without a newline still appear.
    After redacting, the last (longest needle - 1) bytes are held back until
    more data arrives: any secret split across two reads is entirely inside
    that tail, so it is caught on the next pass instead of leaking half."""

    def __init__(self, src_fd, out, pairs):
        self.src_fd = src_fd
        self.out = out
        self.pairs = pairs
        self.hold = max((len(n) for n, _ in pairs), default=1) - 1

    def run(self):
        buf = b""
        while True:
            try:
                chunk = os.read(self.src_fd, 65536)
            except OSError:
                chunk = b""
            if not chunk:
                break
            buf = _vault_redact(buf + chunk, self.pairs)
            if len(buf) > self.hold:
                cut = len(buf) - self.hold
                self._write(buf[:cut])
                buf = buf[cut:]
        if buf:
            self._write(_vault_redact(buf, self.pairs))
        try:
            os.close(self.src_fd)
        except OSError:
            pass

    def _write(self, data):
        try:
            self.out.write(data)
            self.out.flush()
        except (OSError, ValueError):
            pass


def _vault_parse_env_specs(vault, specs):
    """--env VAR=name / --env name  ->  ([(var, name)], error)."""
    out = []
    for spec in specs or []:
        if "=" in spec:
            var, name = spec.split("=", 1)
            var, name = var.strip(), name.strip()
        else:
            name = spec.strip()
            entry = vault.vault_get_entry(name)
            var = (entry or {}).get("env_var") or ""
            if not var:
                return None, (f"--env {spec}: no env var stored for that entry; "
                              f"use --env VAR={spec}")
        if not vault.VAULT_ENV_VAR_RE.match(var):
            return None, f"--env {spec}: {var!r} is not a valid environment variable name"
        if not name:
            return None, f"--env {spec}: missing entry name"
        out.append((var, name))
    return out, None


def cmd_vault_exec(args):
    import threading
    vault = _vault_module()
    cmd = list(args.cmd or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        print("ccc vault exec: missing command (usage: ccc vault exec --env VAR=<name> -- <cmd...>)",
              file=sys.stderr)
        return 2
    if not args.env:
        print("ccc vault exec: pass at least one --env VAR=<name>", file=sys.stderr)
        return 2
    mapping, err = _vault_parse_env_specs(vault, args.env)
    if err:
        print(f"ccc vault exec: {err}", file=sys.stderr)
        return 2
    env = dict(os.environ)
    secrets = []
    for var, name in mapping:
        value = vault.vault_get_value(name)
        if not value:
            print(f"ccc vault exec: no saved value for {name!r} (see `ccc vault list`)", file=sys.stderr)
            return 2
        env[var] = value
        secrets.append((vault.vault_normalize_name(name), value))
    pairs = _vault_redaction_pairs(secrets)
    out_r, out_w = os.pipe()
    err_r, err_w = os.pipe()
    try:
        proc = subprocess.Popen(cmd, env=env, stdout=out_w, stderr=err_w)
    except OSError as e:
        os.close(out_r); os.close(out_w); os.close(err_r); os.close(err_w)
        print(f"ccc vault exec: cannot run {cmd[0]!r}: {e.strerror or e}", file=sys.stderr)
        return 127
    os.close(out_w)
    os.close(err_w)
    pumps = [
        threading.Thread(target=_VaultRedactingPump(out_r, sys.stdout.buffer, pairs).run, daemon=True),
        threading.Thread(target=_VaultRedactingPump(err_r, sys.stderr.buffer, pairs).run, daemon=True),
    ]
    for t in pumps:
        t.start()
    while True:
        try:
            rc = proc.wait()
            break
        except KeyboardInterrupt:
            # The child shares our process group and got the SIGINT too;
            # keep draining its (redacted) output until it exits.
            continue
    for t in pumps:
        t.join()
    return 128 - rc if rc < 0 else rc


