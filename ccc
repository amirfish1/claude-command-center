"""ccc — command-line client for a running Claude Command Center server.

Answers "what sessions exist and what are they doing right now" in one
command, without opening the dashboard:

    ccc sessions              # live census table (alias: list-sessions)
    ccc sessions --since 5h   # only sessions active within the window
    ccc sessions --json       # raw census envelope (agent-consumable)

    ccc spawn "fix the flaky test"            # new session, server defaults
    ccc spawn "…" --engine claude --model opus-5 --effort high
    ccc spawn "…" --name queue-drain --cwd ~/Apps/foo --report-to <sid>
    ccc spawn --continue-from <old session> "keep going"   # new session, not a resume
    ccc models               # every engine's models, efforts, cost
    ccc models --engine claude --json
    ccc doctor               # per-engine CLI/auth/BYOK health, dry-run only

    ccc quota                # weekly quota left per engine + reset deadline

    ccc send <session> "message"        # fire-and-forget into a session
    ccc send <session> "…" --steer      # interrupt the current turn with it
    ccc send <session> "…" --new-if-large-and-stale   # continuation instead of a cold resume, when warranted
    ccc ask <session> "question"        # send and wait for the reply text

    ccc recall "that bug with the flaky test"   # sessions that touched it
    ccc shipped "dark mode"                     # did we already build this?
    ccc history src/app.py                      # commits + sessions that touched a file
    ccc decisions "which queue engine"          # sessions that recorded a decision
    ccc brief <session>                         # where a session left off + how to resume it
    ccc where <session|query>                   # plain-language status + human checklist + continue

    ccc consent                                 # what CCC may write into your agent config
    ccc consent show <item>                     # exact diff for one item
    ccc consent approve <item...|all>           # or: decline / revoke <item...|all>

    ccc jobs ls [--host hermes]                 # scheduled jobs: status, last/next run, outcome
    ccc jobs add --host hermes --repo BYM --what "..." --when "hourly" [--name slug] [--wait]
                                                # an agent session creates the job (POST /api/jobs/add)

    ccc vault list [--json]                     # Vault entries: name/kind/service/env var, never values
    ccc vault get <name> [--reveal]             # exit 0 if saved; prints the value only with --reveal
    ccc vault exec --env VAR=<name> [--env ...] -- <cmd...>
                                                # run cmd with secrets in env, redacted from its output

    ccc astra-check <sid> ... # cost/behavior score for a Codex session (scripts/astra-check)
    ccc brain <subcmd> ...    # passthrough to an optional private plugin (no-op if unconfigured)

<session> is a session id, a unique id prefix, or a (unique, case-
insensitive) fragment of the session's display name from `ccc sessions`.

Agents: model ids and effort ladders differ per engine and change over
time — never guess them. `ccc models` is the live catalog; pass its ids
to `ccc spawn --model` / `--effort` verbatim. Before building a feature, run
`ccc shipped` to check it isn't already done; when a task references
earlier work, run `ccc recall` instead of guessing from scratch. To resume a
specific earlier session, run `ccc brief <session>` first — it answers
"where did this stop" without opening the transcript.
When a task needs an API key, token or login, use `ccc vault exec --env
VAR=<name> -- <cmd>` rather than `ccc vault get --reveal`: exec keeps the
value out of your transcript and redacts it from the command's output.

Server discovery: --server URL > $CCC_SERVER > the port.txt the server
publishes at ~/.claude/command-center/port.txt (see write_port_file in
ccc_server/fleet_jobs.py). Stdlib-only by design, like server.py.
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import shutil
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

PORT_FILE = os.path.expanduser("~/.claude/command-center/port.txt")

SUBCOMMANDS = ("sessions", "list-sessions", "spawn", "models", "doctor", "send", "ask", "quota",
               "rebind-report-to", "recall", "shipped", "history", "decisions", "brief", "where",
               "brain", "consent", "jobs", "vault")

BRAIN_CONFIG_FILE = os.path.expanduser("~/.claude/command-center/brain-plugin.json")

_SINCE_RE = re.compile(r"^(\d+)\s*([smhd])$", re.IGNORECASE)
_SINCE_UNIT_S = {"s": 1, "m": 60, "h": 3600, "d": 86400}

# Release dates aren't published in any catalog source (Anthropic's docs
# give cutoffs and retirement dates, not release dates), so the `released`
# column is derived from the only date signal that exists: a trailing date
# in the model id itself (-2024-05-13 or -20240513). Dated ids only.
_RELEASED_RE = re.compile(r"-(\d{4})-?(\d{2})-?(\d{2})$")


def _id_release_date(model_id):
    m = _RELEASED_RE.search(model_id or "")
    if not m:
        return ""
    year, month, day = (int(g) for g in m.groups())
    if not (1 <= month <= 12 and 1 <= day <= 31):
        return ""
    return f"{year:04d}-{month:02d}-{day:02d}"

# --sort status category order: waiting (blocked on a human) is the most
# actionable, then working, idle, ended. Within a category the server's
# recency order is preserved (sorted() is stable).
_STATUS_RANK = {"waiting": 0, "working": 1, "idle": 2, "ended": 3}


def _resolve_server(args_server):
    if args_server:
        return args_server.rstrip("/")
    env = (os.environ.get("CCC_SERVER") or "").strip()
    if env:
        return env.rstrip("/")
    try:
        with open(PORT_FILE) as f:
            url = f.read().strip()
    except OSError:
        return None
    return url.rstrip("/") if url else None


_CLI_USER_AGENT = "ccc-cli"


def _caller_pid_chain(max_depth=16):
    """This process's PID ancestry, innermost (self) first.

    `ccc spawn` run from inside an agent session should land in that session's
    lane map, but only Claude Code exports a session id to its shell children
    (CLAUDE_CODE_SESSION_ID). Codex exports nothing per-conversation, so there
    is no env to read — the one thing that IS true is that `ccc` is a
    descendant of whatever process is driving the session. Ship the ancestry
    and let the server match it against what it already knows (spawn registry
    pids, ~/.claude/sessions/*.json, the shared Codex app-server).

    One `ps` call, bounded walk, failures are silent: attribution is a nicety,
    never a reason for a spawn to fail.
    """
    try:
        out = subprocess.run(
            ["ps", "-A", "-o", "pid=,ppid="],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    parent_of = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        try:
            parent_of[int(parts[0])] = int(parts[1])
        except ValueError:
            continue
    chain = []
    pid = os.getpid()
    seen = set()
    while pid and pid > 1 and pid not in seen and len(chain) < max_depth:
        chain.append(pid)
        seen.add(pid)
        pid = parent_of.get(pid, 0)
    return chain


def _get_json(base, path, timeout=10):
    req = urllib.request.Request(
        base + path, headers={"Accept": "application/json", "User-Agent": _CLI_USER_AGENT}
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


_NODE_STATUS_TEXT = {
    "timeout": "timed out",
    "peer_offline": "offline",
    "unsupported_capability": "needs a CCC update for memory federation",
    "skipped_backoff": "skipped (backing off after a failure)",
    "unpaired_peer": "not paired back with this machine",
    "error": "error",
}


def _node_status_lines(payload):
    """`[hermes timed out]`-style lines for every peer that didn't answer a
    scope=all memory query. Peers that answered print nothing. `nodes` is
    the fan-out list on recall/shipped/history; brief uses `node_status`
    (its `nodes` key was already a lineage-ref map)."""
    nodes = payload.get("node_status") if "node_status" in payload else payload.get("nodes")
    lines = []
    for n in nodes if isinstance(nodes, list) else []:
        if not isinstance(n, dict) or n.get("self") or n.get("status") == "ok":
            continue
        text = _NODE_STATUS_TEXT.get(n.get("status"), n.get("status") or "?")
        if n.get("stale"):
            age = n.get("cache_age_s")
            text += f"; showing its answer from {max(0, int(age or 0) // 60)} min ago"
        lines.append(f"[{n.get('name') or '?'} {text}]")
    return lines


def _post_json(base, path, payload, timeout=60):
    """POST JSON, returning (status, payload). HTTP error statuses still carry
    a JSON body on /api/sessions/spawn (error + supported_engines et al), so
    parse it instead of raising. Raises URLError only for transport failures."""
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        base + path,
        data=body,
        headers={
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": _CLI_USER_AGENT,
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read().decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return e.code, {"ok": False, "error": f"HTTP {e.code}"}


def _parse_since(text):
    m = _SINCE_RE.match((text or "").strip())
    if not m:
        raise argparse.ArgumentTypeError(f"--since expects like 30s/15m/5h/2d, got {text!r}")
    return int(m.group(1)) * _SINCE_UNIT_S[m.group(2).lower()]


def _fmt_age(age_s):
    if age_s is None:
        return "?"
    age_s = int(age_s)
    if age_s < 60:
        return f"{age_s}s"
    if age_s < 3600:
        return f"{age_s // 60}m"
    if age_s < 86400:
        return f"{age_s // 3600}h{age_s % 3600 // 60:02d}m"
    return f"{age_s // 86400}d{age_s % 86400 // 3600:02d}h"


def cmd_sessions(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    try:
        census_path = "/api/sessions/census"
        if args.since is not None:
            # Server widens the candidate pool with recently-ended sessions in
            # the window; the client-side filter below then applies uniformly.
            census_path += f"?since={args.since}"
        payload = _get_json(base, census_path)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    sessions = list(payload.get("sessions") or [])
    if args.since is not None:
        sessions = [
            s for s in sessions
            if s.get("last_event_age_s") is not None and s["last_event_age_s"] <= args.since
        ]
    if args.json:
        out = dict(payload)
        out["sessions"] = sessions
        print(json.dumps(out, indent=2))
        return 0

    n_helpers = sum(1 for s in sessions if s.get("helper"))
    if not args.all:
        sessions = [s for s in sessions if not s.get("helper")]
    if args.sort == "status":
        sessions = sorted(sessions, key=lambda s: _STATUS_RANK.get(s.get("state") or "", 4))

    children_of = {}
    for s in sessions:
        parent = s.get("parent_session_id") or ""
        if parent:
            children_of.setdefault(parent, []).append(s)
    sids = {s.get("session_id") for s in sessions}
    roots = [s for s in sessions if (s.get("parent_session_id") or "") not in sids]

    home_prefix = os.path.expanduser("~") + os.sep

    def _row(s, depth=0, child=False):
        flags = ""
        if s.get("needs_approval"):
            flags += " !approval"
        if s.get("question_waiting"):
            flags += " ?question"
        if s.get("unanswered_input"):
            flags += " !unanswered"
        if s.get("stuck"):
            flags += " !stuck"
            if s.get("stuck_age_s") is not None:
                flags += f" {_fmt_age(s['stuck_age_s'])} silent"
        tool = s.get("pending_tool") or "-"
        if s.get("turn_age_s") is not None and s.get("state") == "working":
            tool = f"{tool} {_fmt_age(s['turn_age_s'])}"
        name = (s.get("name") or "(no conversation row)")[:44]
        marker = ("  " * depth + "↳ ") if (depth or child) else ""
        engine_effort = f"{s.get('engine') or '?'}/{s.get('effort') or '?'}"
        via = s.get("spawned_via") or "terminal"
        if via in ("-", "none", "null", "not-available", "not available"):
            via = "terminal"
        path = s.get("repo_path") or "?"
        if path.startswith(home_prefix):
            path = path[len(home_prefix):]
        print(
            f"{_fmt_age(s.get('last_event_age_s')):>7}  {marker}{name:<44} "
            f"{s.get('state') or '?':<8} {(s.get('model') or '?')[:18]:<18} "
            f"{s.get('session_id') or '?'}  {engine_effort:<14} "
            f"via:{via:<6} {path}  {tool}{flags}"
        )

    def _walk(s, depth):
        _row(s, depth)
        kids = children_of.get(s.get("session_id")) or ()
        if args.sort == "status":
            kids = sorted(kids, key=lambda c: (
                _STATUS_RANK.get(c.get("state") or "", 4),
                c.get("last_event_age_s") if c.get("last_event_age_s") is not None else float("inf"),
            ))
        else:
            kids = sorted(kids, key=lambda c: c.get("last_event_age_s") or 0)
        for child in kids:
            _walk(child, depth + 1)

    if args.tree:
        for s in roots:
            _walk(s, 0)
    else:
        # Flat (default): every row in the requested sort order, children
        # marked ↳ inline. Nesting under parents (--tree) groups families but
        # breaks the global sort order — the hiding problem in new clothes.
        for s in sessions:
            _row(s, 0, child=bool(s.get("parent_session_id")))
    n = len(sessions)
    n_live = sum(1 for s in sessions if s.get("state") != "ended")
    n_ended = n - n_live
    n_orphan = sum(1 for s in sessions if not s.get("has_conversation_row"))
    counts = f"{n_live} live"
    if n_ended:
        counts += f" + {n_ended} ended"
    suffix = f", {n_orphan} with no conversation row" if n_orphan else ""
    print(f"\n{counts} session{'s' if n != 1 else ''}{suffix}")
    if n_helpers and not args.all:
        print(f"({n_helpers} CCC helper session{'s' if n_helpers != 1 else ''} hidden — auto-title bots; --all to show)")
    return 0


def _resolve_target(base, target):
    """Turn a user-supplied target (session id, unique id prefix, or unique
    name fragment) into a session id, using the live census. Returns
    (session_id, error_message) — exactly one is set. An unmatched target
    passes through untouched so server-side aliases (bridge ULIDs, spawn
    prefixes) still work."""
    target = (target or "").strip()
    try:
        payload = _get_json(base, "/api/sessions/census")
        sessions = list(payload.get("sessions") or [])
    except OSError:
        return target, None  # census unreachable — let the send itself report
    ids = [s.get("session_id") or "" for s in sessions]
    if target in ids:
        return target, None
    prefix = [sid for sid in ids if sid and sid.startswith(target)]
    if len(prefix) == 1:
        return prefix[0], None
    needle = target.lower()
    named = [
        s for s in sessions
        if needle and needle in (s.get("name") or "").lower()
    ]
    if len(named) == 1:
        return named[0].get("session_id") or target, None
    if len(named) > 1:
        lines = "\n".join(
            f"  {s.get('session_id')}  {s.get('name')}" for s in named[:8]
        )
        return None, (
            f"ccc: {target!r} matches {len(named)} sessions — be more "
            f"specific or use the id:\n{lines}"
        )
    if len(prefix) > 1:
        return None, f"ccc: id prefix {target!r} is ambiguous ({len(prefix)} sessions)"
    return target, None


def cmd_send(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    text = " ".join(args.text).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        print("ccc send: missing message (pass it as an argument or pipe it on stdin)",
              file=sys.stderr)
        return 2
    sid, err = _resolve_target(base, args.target)
    if err:
        print(err, file=sys.stderr)
        return 1
    if args.new_if_large_and_stale or args.dry_run:
        qs = urllib.parse.urlencode({
            "large_threshold": args.large_threshold, "stale_seconds": args.stale_seconds,
        })
        try:
            decision = _get_json(
                base, f"/api/sessions/continuation-decision/{urllib.parse.quote(sid, safe='')}?{qs}"
            )
        except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
            print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
            return 1
        if not args.json:
            ctx_k = decision.get("context_tokens") or 0
            idle_s = int(decision.get("idle_seconds") or 0)
            print(f"decision: {decision['path']} — {decision['reason']} "
                  f"(context={ctx_k:,} tokens, idle={idle_s}s)")
        if args.dry_run and not args.new_if_large_and_stale:
            if args.json:
                print(json.dumps(decision, indent=2))
            return 0
        if args.new_if_large_and_stale and decision["path"] == "new":
            return _spawn_continue_from(base, decision.get("resolved_session_id") or sid, text, args)
        if args.dry_run:
            preview = {"path": "normal", "session_id": sid, "text": text}
            if args.json:
                print(json.dumps(preview, indent=2))
            else:
                print(f"[dry-run] would send normally to {sid}")
            return 0
    payload = {"session_id": sid, "text": text}
    sender_sid = getattr(args, "sender", None) or os.environ.get("CLAUDE_SESSION_ID") or None
    if sender_sid:
        resolved_sender, _ = _resolve_target(base, sender_sid)
        payload["peer_sender_sid"] = resolved_sender or sender_sid
    if args.steer:
        payload["mode"] = "steer"
    elif args.queue:
        payload["mode"] = "queue"
    try:
        status, result = _post_json(base, "/api/inject-input", payload)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1
    if not result.get("ok"):
        print(f"ccc: send failed: {result.get('error') or f'HTTP {status}'}", file=sys.stderr)
        return 1
    effect = result.get("effect") or result.get("landed") or "delivered"
    print(f"sent to {sid} ({effect})")
    return 0


def cmd_ask(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    text = " ".join(args.text).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        print("ccc ask: missing question (pass it as an argument or pipe it on stdin)",
              file=sys.stderr)
        return 2
    sid, err = _resolve_target(base, args.target)
    if err:
        print(err, file=sys.stderr)
        return 1
    timeout_ms = int(args.timeout * 1000)
    try:
        # HTTP timeout outlasts the server-side wait so the server, not the
        # transport, decides when the ask has timed out.
        status, result = _post_json(
            base, "/api/ask",
            {"session_id": sid, "text": text, "timeout_ms": timeout_ms},
            timeout=timeout_ms / 1000 + 30,
        )
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1
    if not result.get("ok"):
        err_text = result.get("error") or f"HTTP {status}"
        print(f"ccc: ask failed: {err_text}", file=sys.stderr)
        if result.get("partial"):
            print(f"--- partial reply ---\n{result['partial']}", file=sys.stderr)
        return 1
    answer = (result.get("text") or "").strip()
    if answer:
        print(answer)
    else:
        # ok:true with no text is a real outcome: the session ended its turn
        # without a message (tool-only turn, or an engine that doesn't reply
        # through the ask channel).
        src = result.get("source") or "?"
        print(f"(session ended its turn with no reply text — source: {src})",
              file=sys.stderr)
    return 0


def cmd_recall(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    text = " ".join(args.query).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        print("ccc recall: missing query (pass it as an argument or pipe it on stdin)",
              file=sys.stderr)
        return 2
    qs = urllib.parse.urlencode({"q": text, "limit": args.limit, "scope": getattr(args, "scope", "all")})
    try:
        payload = _get_json(base, f"/api/memory/recall?{qs}", timeout=15)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    results = payload.get("results") or []
    if not results:
        if payload.get("indexing"):
            print(f"(indexing: true — no sessions found yet for {text!r}, still warming up)")
        else:
            print(f"(no sessions found for {text!r})")
        for line in _node_status_lines(payload):
            print(line)
        return 0
    tty = sys.stdout.isatty()
    width = shutil.get_terminal_size((100, 20)).columns if tty else 100
    bold = (lambda t: f"\033[1m{t}\033[0m") if tty else (lambda t: t)
    dim = (lambda t: f"\033[2m{t}\033[0m") if tty else (lambda t: t)

    def _clean(t):
        # Drop CCC's own injected preambles so the snippet shows the ask itself.
        t = " ".join(str(t or "").split())
        t = re.sub(r"^Heads-up: this may already be shipped:.*?Verify before rebuilding\.\s*", "", t)
        return t

    def _fit(t, room):
        return t if len(t) <= room else t[: max(room - 1, 0)].rstrip() + "…"

    for i, r in enumerate(results, 1):
        sid = str(r.get("session_id") or "?")
        short = sid.removeprefix("session_")[:8]
        title = _clean(r.get("title")) or "(untitled)"
        tag = f"[{r.get('node_name')}] " if r.get("local") is False else ""
        head = f"{i:>2}. {short}  "
        print(head + bold(_fit(tag + title, width - len(head))))
        collapsed = r.get("chain_collapsed") or 0
        also = ", ".join(a.get("node_name") or "?" for a in r.get("also_on") or [])
