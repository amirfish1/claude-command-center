def _wait_for_turn_end(base, sid, timeout_s, poll_s=5.0):
    """Block until the spawned session stops working; return (ok, text).
    Polls GET /api/session/<sid> (state + last_assistant_text)."""
    import time
    deadline = time.monotonic() + timeout_s
    seen_working = False
    started = time.monotonic()
    while time.monotonic() < deadline:
        try:
            d = _get_json(base, f"/api/session/{urllib.parse.quote(sid, safe='')}", timeout=15)
        except urllib.error.HTTPError as e:
            if e.code != 404:
                return False, f"HTTP {e.code}"
            d = {}
        except OSError:
            d = {}
        state = d.get("state") if d.get("ok") else None
        if state == "working":
            seen_working = True
        # A brand-new transcript can read as idle before the first turn starts;
        # accept a non-working state once the turn was seen or after a grace.
        elif state and (seen_working or time.monotonic() - started > 60):
            return True, (d.get("last_assistant_text") or "").strip()
        time.sleep(poll_s)
    return False, "timeout"


def cmd_jobs_add(args):
    base = _resolve_server(args.server)
    if not base:
        print(f"ccc: no server found — is CCC running? (looked for --server, $CCC_SERVER, {PORT_FILE})",
              file=sys.stderr)
        return 1
    payload = {"host": args.host, "repo": args.repo, "what": args.what, "when": args.when,
               "cwd": os.getcwd()}
    for key in ("name", "model", "engine", "effort"):
        if getattr(args, key, None):
            payload[key] = getattr(args, key)
    if os.environ.get("CLAUDE_CODE_SESSION_ID"):
        payload["report_to"] = os.environ["CLAUDE_CODE_SESSION_ID"]
    else:
        chain = _caller_pid_chain()
        if chain:
            payload["caller_pids"] = chain
            payload["caller_cwd"] = os.getcwd()
    try:
        status, result = _post_json(base, "/api/jobs/add", payload, timeout=90)
    except OSError as e:
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if not result.get("ok"):
        if args.json:
            print(json.dumps(result, indent=2))
        print(f"ccc: jobs add failed: {result.get('error') or f'HTTP {status}'}", file=sys.stderr)
        return 1
    sid = result.get("session_id") or ""
    if not args.wait:
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"spawned session {sid or '?'} ({result.get('session_name')}) to create the job")
            print("track it: ccc sessions   list jobs: ccc jobs ls")
        return 0
    if not sid:
        print("ccc: spawn returned no session id; cannot --wait", file=sys.stderr)
        return 1
    print(f"spawned session {sid} ({result.get('session_name')}); waiting for it to finish...",
          file=sys.stderr)
    ok, text = _wait_for_turn_end(base, sid, args.timeout)
    if args.json:
        print(json.dumps(dict(result, wait_ok=ok, reply=text if ok else None,
                              wait_error=None if ok else text), indent=2))
        return 0 if ok else 1
    if not ok:
        print(f"ccc: jobs add --wait: {text} (session {sid} may still be running)", file=sys.stderr)
        return 1
    print(text or "(session ended its turn with no reply text)")
    return 0


