                    "LaunchAgent (laptop) and checks it appears in `ccc jobs ls`.",
    )
    jp.add_argument("--host", required=True, choices=("hermes", "laptop"))
    jp.add_argument("--repo", required=True,
                    help="repo path or folder name (hermes: /home/hermes/Apps/<folder>)")
    jp.add_argument("--what", required=True, help="what the job should do, in plain English")
    jp.add_argument("--when", required=True, help='when it runs, e.g. "hourly", "daily 7am"')
    jp.add_argument("--name", help="kebab-case job name (default: the agent picks one)")
    jp.add_argument("--model", help="model for the spawned session (see `ccc models`)")
    jp.add_argument("--engine", help="engine for the spawned session")
    jp.add_argument("--effort", help="reasoning effort for the spawned session")
    jp.add_argument("--wait", action="store_true",
                    help="block until the session ends its turn and print its final reply")
    jp.add_argument("--timeout", type=float, default=1800.0, metavar="SECONDS",
                    help="with --wait: give up after this long (default 1800)")
    jp.add_argument("--json", action="store_true", help="raw result JSON")
    jp.set_defaults(func=cmd_jobs_add)

    p = sub.add_parser(
        "vault",
        help="local secrets (API keys, tokens, logins) from Settings > Vault",
        description="Reads the Vault straight from this machine's Keychain "
                    "(or encrypted file); no server needed. Agents: prefer "
                    "`exec`, which keeps values out of your output.",
    )
    vsub = p.add_subparsers(dest="vault_command", required=True)
    vp = vsub.add_parser("list", help="entries: name, kind, service, username, env var (never values)")
    vp.add_argument("--json", action="store_true", help="machine-readable list")
    vp.set_defaults(func=cmd_vault_list)
    vp = vsub.add_parser("get", help="exit 0 if the entry has a saved value; --reveal prints it")
    vp.add_argument("name")
    vp.add_argument("--reveal", action="store_true",
                    help="print the secret value to stdout (avoid in agent transcripts)")
    vp.set_defaults(func=cmd_vault_get)
    vp = vsub.add_parser(
        "exec",
        help="run a command with secrets in its env; values are redacted from its output",
        description="ccc vault exec --env STRIPE_KEY=stripe-live [--env ...] -- <cmd...>. "
                    "--env <name> alone uses the entry's stored env var. The child's "
                    "stdout/stderr are piped through a redactor that replaces each "
                    "value with [REDACTED:<name>]. Exits with the command's status.",
    )
    vp.add_argument("--env", action="append", metavar="VAR=NAME",
                    help="map env var VAR to vault entry NAME (repeatable)")
    vp.add_argument("cmd", nargs=argparse.REMAINDER, help="-- then the command to run")
    vp.set_defaults(func=cmd_vault_exec)

    p = sub.add_parser(
        "brain",
        help="passthrough to an optional private 'brain' plugin, if configured",
        description="Execs <plugin_path>/bin/brain (from "
                    f"{BRAIN_CONFIG_FILE}) with the given args, inheriting "
                    "stdio. No-op error if no plugin is configured.",
    )
    p.add_argument("args", nargs=argparse.REMAINDER, help="args passed through to the plugin's own CLI")
    p.set_defaults(func=cmd_brain)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
