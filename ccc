"""ccc — command-line client for a running Claude Command Center server.

Answers "what sessions exist and what are they doing right now" in one
command, without opening the dashboard:

    ccc sessions              # live census table (alias: list-sessions)
    ccc sessions --since 5h   # only sessions active within the window
    ccc sessions --json       # raw census envelope (agent-consumable)

    ccc spawn "fix the flaky test"            # new session, server defaults
    ccc spawn "…" --engine claude --model opus-5 --effort high
    ccc spawn "…" --name queue-drain --cwd ~/Apps/foo --report-to <sid>
    ccc models               # every engine's models, efforts, cost
    ccc models --engine claude --json

Agents: model ids and effort ladders differ per engine and change over
time — never guess them. `ccc models` is the live catalog; pass its ids
to `ccc spawn --model` / `--effort` verbatim.

Server discovery: --server URL > $CCC_SERVER > the port.txt the server
publishes at ~/.claude/command-center/port.txt (see write_port_file in
ccc_server/fleet_jobs.py). Stdlib-only by design, like server.py.
"""

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request

PORT_FILE = os.path.expanduser("~/.claude/command-center/port.txt")

SUBCOMMANDS = ("sessions", "list-sessions", "spawn", "models")

_SINCE_RE = re.compile(r"^(\d+)\s*([smhd])$", re.IGNORECASE)
_SINCE_UNIT_S = {"s": 1, "m": 60, "h": 3600, "d": 86400}

# --sort status category order: waiting (blocked on a human) is the most
# actionable, then working, idle, ended. Within a category the server's
# recency order is preserved (sorted() is stable).
_STATUS_RANK = {"waiting": 0, "working": 1, "idle": 2, "ended": 3}


def _resolve_server(args_server):
    if args_server:
        return args_server.rstrip("/")
    env = (os.environ.get("CCC_SERVER") or "").strip()
    if env:
        return env.rstrip("/")
    try:
        with open(PORT_FILE) as f:
            url = f.read().strip()
    except OSError:
        return None
    return url.rstrip("/") if url else None


def _get_json(base, path):
    req = urllib.request.Request(base + path, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _post_json(base, path, payload, timeout=60):
    """POST JSON, returning (status, payload). HTTP error statuses still carry
    a JSON body on /api/sessions/spawn (error + supported_engines et al), so
    parse it instead of raising. Raises URLError only for transport failures."""
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        base + path,
        data=body,
        headers={"Accept": "application/json", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read().decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return e.code, {"ok": False, "error": f"HTTP {e.code}"}


def _parse_since(text):
    m = _SINCE_RE.match((text or "").strip())
    if not m:
        raise argparse.ArgumentTypeError(f"--since expects like 30s/15m/5h/2d, got {text!r}")
    return int(m.group(1)) * _SINCE_UNIT_S[m.group(2).lower()]


def _fmt_age(age_s):
    if age_s is None:
        return "?"
    age_s = int(age_s)
    if age_s < 60:
        return f"{age_s}s"
    if age_s < 3600:
        return f"{age_s // 60}m"
    if age_s < 86400:
        return f"{age_s // 3600}h{age_s % 3600 // 60:02d}m"
    return f"{age_s // 86400}d{age_s % 86400 // 3600:02d}h"


def cmd_sessions(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    try:
        census_path = "/api/sessions/census"
        if args.since is not None:
            # Server widens the candidate pool with recently-ended sessions in
            # the window; the client-side filter below then applies uniformly.
            census_path += f"?since={args.since}"
        payload = _get_json(base, census_path)
    except urllib.error.URLError as e:
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    sessions = list(payload.get("sessions") or [])
    if args.since is not None:
        sessions = [
            s for s in sessions
            if s.get("last_event_age_s") is not None and s["last_event_age_s"] <= args.since
        ]
    if args.json:
        out = dict(payload)
        out["sessions"] = sessions
        print(json.dumps(out, indent=2))
        return 0

    n_helpers = sum(1 for s in sessions if s.get("helper"))
    if not args.all:
        sessions = [s for s in sessions if not s.get("helper")]
    if args.sort == "status":
        sessions = sorted(sessions, key=lambda s: _STATUS_RANK.get(s.get("state") or "", 4))

    children_of = {}
    for s in sessions:
        parent = s.get("parent_session_id") or ""
        if parent:
            children_of.setdefault(parent, []).append(s)
    sids = {s.get("session_id") for s in sessions}
    roots = [s for s in sessions if (s.get("parent_session_id") or "") not in sids]

    home_prefix = os.path.expanduser("~") + os.sep

    def _row(s, depth=0, child=False):
        flags = ""
        if s.get("needs_approval"):
            flags += " !approval"
        if s.get("question_waiting"):
            flags += " ?question"
        if s.get("unanswered_input"):
            flags += " !unanswered"
        if s.get("stuck"):
            flags += " !stuck"
            if s.get("stuck_age_s") is not None:
                flags += f" {_fmt_age(s['stuck_age_s'])} silent"
        tool = s.get("pending_tool") or "-"
        if s.get("turn_age_s") is not None and s.get("state") == "working":
            tool = f"{tool} {_fmt_age(s['turn_age_s'])}"
        name = (s.get("name") or "(no conversation row)")[:44]
        marker = ("  " * depth + "↳ ") if (depth or child) else ""
        engine_effort = f"{s.get('engine') or '?'}/{s.get('effort') or '?'}"
        path = s.get("repo_path") or "?"
        if path.startswith(home_prefix):
            path = path[len(home_prefix):]
        print(
            f"{_fmt_age(s.get('last_event_age_s')):>7}  {marker}{name:<44} "
            f"{s.get('state') or '?':<8} {(s.get('model') or '?')[:18]:<18} "
            f"{s.get('session_id') or '?'}  {engine_effort:<14} "
            f"{path}  {tool}{flags}"
        )

    def _walk(s, depth):
        _row(s, depth)
        kids = children_of.get(s.get("session_id")) or ()
        if args.sort == "status":
            kids = sorted(kids, key=lambda c: (
                _STATUS_RANK.get(c.get("state") or "", 4),
                c.get("last_event_age_s") if c.get("last_event_age_s") is not None else float("inf"),
            ))
        else:
            kids = sorted(kids, key=lambda c: c.get("last_event_age_s") or 0)
        for child in kids:
            _walk(child, depth + 1)

    if args.tree:
        for s in roots:
            _walk(s, 0)
    else:
        # Flat (default): every row in the requested sort order, children
        # marked ↳ inline. Nesting under parents (--tree) groups families but
        # breaks the global sort order — the hiding problem in new clothes.
        for s in sessions:
            _row(s, 0, child=bool(s.get("parent_session_id")))
    n = len(sessions)
    n_live = sum(1 for s in sessions if s.get("state") != "ended")
    n_ended = n - n_live
    n_orphan = sum(1 for s in sessions if not s.get("has_conversation_row"))
    counts = f"{n_live} live"
    if n_ended:
        counts += f" + {n_ended} ended"
    suffix = f", {n_orphan} with no conversation row" if n_orphan else ""
    print(f"\n{counts} session{'s' if n != 1 else ''}{suffix}")
    if n_helpers and not args.all:
        print(f"({n_helpers} CCC helper session{'s' if n_helpers != 1 else ''} hidden — auto-title bots; --all to show)")
    return 0


def cmd_models(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    try:
        payload = _get_json(base, "/api/engines/models")
    except urllib.error.URLError as e:
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    catalog = payload.get("catalog") or {}
    efforts_by_engine = payload.get("efforts_by_engine") or {}
    if args.engine:
        catalog = {k: v for k, v in catalog.items() if k == args.engine}
        if not catalog:
            known = ", ".join(sorted(payload.get("catalog") or {}))
            print(f"ccc: unknown engine {args.engine!r} (known: {known})", file=sys.stderr)
            return 1
    if args.json:
        out = dict(payload)
        if args.engine:
            out["catalog"] = catalog
        print(json.dumps(out, indent=2))
        return 0

    for engine, bucket in catalog.items():
        default = bucket.get("default") or ""
        ladder = efforts_by_engine.get(engine) or []
        header = engine
        if default:
            header += f"  (default: {default})"
        if ladder:
            header += f"  efforts: {','.join(ladder)}"
        if bucket.get("supports_custom"):
            header += "  [custom ids accepted]"
        print(header)
        models = bucket.get("models") or []
        if not models:
            print("  (no catalogued models — spawn uses the default above)")
        for m in models:
            efforts = m.get("reasoning_efforts") or []
            cost = m.get("cost_summary") or m.get("cost_tier") or ""
            notes = []
            if m.get("id") == default:
                notes.append("default")
            if m.get("available") is False:
                notes.append("unavailable")
            if m.get("oneM"):
                notes.append("1M ctx")
            if efforts and efforts != ladder:
                notes.append("efforts: " + ",".join(str(e) for e in efforts))
            label = m.get("label") or ""
            if label == m.get("id"):
                label = ""
            print(
                f"  {m.get('id') or '?':<44} {cost:<22} "
                f"{('; '.join(notes)):<28} {label}".rstrip()
            )
    print("\nuse: ccc spawn \"<prompt>\" --engine <engine> --model <id> [--effort <level>]")
    return 0


def cmd_spawn(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    prompt = " ".join(args.prompt).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        print("ccc spawn: missing prompt (pass it as an argument or pipe it on stdin)",
              file=sys.stderr)
        return 2
    payload = {"prompt": prompt}
    if args.engine:
        payload["engine"] = args.engine
    if args.model:
        payload["model"] = args.model
    if args.effort:
        payload["reasoning_effort"] = args.effort
    if args.name:
        payload["name"] = args.name
    # The endpoint is repo-scoped (explicit cwd/repo_path required). A CLI's
    # natural scope is the directory it was invoked from.
    payload["cwd"] = args.cwd or os.getcwd()
    if args.worktree:
        payload["worktree"] = True
    if args.report_to:
        payload["report_to"] = args.report_to
    try:
        status, result = _post_json(base, "/api/sessions/spawn", payload)
    except urllib.error.URLError as e:
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1
    if not result.get("ok"):
        print(f"ccc: spawn failed: {result.get('error') or f'HTTP {status}'}", file=sys.stderr)
        if result.get("supported_engines"):
            print(f"  engines: {', '.join(result['supported_engines'])}", file=sys.stderr)
        if result.get("known_codex_models"):
            print(f"  known codex models: {', '.join(result['known_codex_models'])}",
                  file=sys.stderr)
        print("  see `ccc models` for valid --engine/--model/--effort values",
              file=sys.stderr)
        return 1
    sid = result.get("session_id") or ""
    pid = result.get("pid")
    engine = result.get("engine") or args.engine or "claude"
    bits = []
    if args.name:
        bits.append(f"name={args.name!r}")
    if args.model:
        bits.append(f"model={args.model}")
    if args.effort:
        bits.append(f"effort={args.effort}")
    ident = f"session {sid}" if sid else (f"pid {pid}" if pid else "session")
    suffix = f"  ({', '.join(bits)})" if bits else ""
    print(f"spawned {engine} {ident}{suffix}")
    print("track it: ccc sessions")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # `ccc` is also the Homebrew launcher's name (foreground server /
    # --install-service). Keep one name for both roles: known query
    # subcommands run the client below; anything else (no args, unknown
    # flags) passes through to ./run.sh so `ccc` still launches CCC.
    if argv and argv[0] not in SUBCOMMANDS and argv[0] not in ("-h", "--help", "--server"):
        run_sh = os.path.join(os.path.dirname(os.path.realpath(__file__)), "run.sh")
        os.execv(run_sh, [run_sh] + argv)
    if not argv:
        run_sh = os.path.join(os.path.dirname(os.path.realpath(__file__)), "run.sh")
        os.execv(run_sh, [run_sh])

    parser = argparse.ArgumentParser(
        prog="ccc",
        description="CLI for a running Claude Command Center server. "
                    "(No subcommand → launches the server via run.sh.)",
    )
    parser.add_argument("--server", help="CCC base URL (default: $CCC_SERVER or port.txt)")
    sub = parser.add_subparsers(dest="command", required=True)

    for name in ("sessions", "list-sessions"):
        p = sub.add_parser(name, help="live session census (state, age, engine, repo, name)")
        p.add_argument("--since", type=_parse_since,
                       help="show sessions (live + recently-ended) with activity in "
                            "the window, e.g. 5h / 30m / 2d")
        p.add_argument("--sort", choices=("recency", "status"), default="recency",
                       help="recency (default): most recent first; status: waiting, "
                            "working, idle, ended — recency within each")
        p.add_argument("--all", action="store_true",
                       help="include CCC helper sessions (auto-title bots), hidden by default")
        p.add_argument("--tree", action="store_true",
                       help="nest children under parents (default: flat, ↳ marks children)")
        p.add_argument("--json", action="store_true", help="raw census JSON")
        p.set_defaults(func=cmd_sessions)

    p = sub.add_parser(
        "spawn",
        help="spawn a new agent session via CCC orchestration",
        description="Spawn a new session on a running CCC server. Model ids and "
                    "effort ladders are per-engine and live in `ccc models` — "
                    "never guess them.",
    )
    p.add_argument("prompt", nargs="*",
                   help="the task prompt (or pipe it on stdin)")
    p.add_argument("--engine",
                   help="claude (default), codex, cursor, antigravity, kilo, "
                        "opencode, aider, hermes, kimi, devin, droid, grok")
    p.add_argument("--model",
                   help="model id for the engine — see `ccc models` (omit for the "
                        "server default)")
    p.add_argument("--effort",
                   help="reasoning effort for engines with a ladder — see the "
                        "EFFORTS in `ccc models`")
    p.add_argument("--name", help="display name for the session")
    p.add_argument("--cwd", help="working directory for the session "
                                 "(default: your current directory)")
    p.add_argument("--worktree", action="store_true",
                   help="run the session in a fresh git worktree")
    p.add_argument("--report-to", metavar="SESSION_ID",
                   help="session the spawned one reports back to on completion "
                        "(orchestration; also becomes its parent)")
    p.add_argument("--json", action="store_true", help="raw spawn result JSON")
    p.set_defaults(func=cmd_spawn)

    p = sub.add_parser(
        "models",
        help="list spawnable engines, models, effort ladders, and cost",
        description="The live server-owned model catalog behind the dashboard "
                    "picker. Use these ids verbatim with `ccc spawn --model`.",
    )
    p.add_argument("--engine", help="only this engine")
    p.add_argument("--json", action="store_true", help="raw catalog JSON")
    p.set_defaults(func=cmd_models)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
