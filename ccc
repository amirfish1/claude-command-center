    if status == "ERROR":
        for error in report.get("errors") or []:
            print(f"  ERROR: {error}")
        return True
    return False


def _parse_iso(ts):
    """Parse the server's ISO-8601 timestamps (offset or trailing Z) into an
    aware datetime; None on anything unexpected."""
    if not isinstance(ts, str) or not ts.strip():
        return None
    text = ts.strip()
    if text.endswith(("Z", "z")):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def _quota_rows(payload):
    """(engine, weekly_block, note) in display order. weekly_block is the
    /api/usage/current {pct, resets_at} window, where pct is percent USED."""
    claude_weekly = (payload.get("claude") or {}).get("seven_day") or {}
    rows = [("claude", claude_weekly, "")]
    for engine in ("codex", "kimi"):
        eng = payload.get(engine) or {}
        note = ""
        if eng.get("stale"):
            note = "stale cache"
        elif eng.get("from_cache"):
            note = "cached"
        rows.append((engine, eng.get("weekly") or {}, note))
    return rows


def cmd_quota(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    try:
        payload = _get_json(base, "/api/usage/current", timeout=15)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0

    now = datetime.now(timezone.utc)
    for engine, block, note in _quota_rows(payload):
        pct = block.get("pct")
        remaining = None if pct is None else max(0, round(100 - float(pct)))
        remaining_s = "?%" if remaining is None else f"{remaining}%"
        reset_dt = _parse_iso(block.get("resets_at"))
        if reset_dt is None:
            when = "?"
        else:
            delta = (reset_dt - now).total_seconds()
            countdown = "overdue" if delta < 0 else f"in {_fmt_age(delta)}"
            when = f"{reset_dt.astimezone().strftime('%a %b %d %H:%M')} ({countdown})"
        flags = ""
        if remaining == 0:
            flags += "  !exhausted"
        if note:
            flags += f"  ({note})"
        print(f"{engine:<8} {remaining_s:>4} remaining   resets {when}{flags}")
    return 0


_CONSENT_STATUS_LABEL = {
    "enabled": "approved",
    "changed": "CHANGED - review",
    "pending": "NEEDS APPROVAL",
    "declined": "declined",
}


def _print_consent_item(item, with_diff):
    status = "skipped (CCC_SKIP_SKILL_INSTALL)" if item.get("skipped_by_env") \
        else _CONSENT_STATUS_LABEL.get(item["status"], item["status"])
    print(f"{item['id']:<32} {status}")
    if not with_diff:
        return
    print(f"  {item['summary']}")
    print(f"  Needed for: {item['depends']}")
    if item.get("error"):
        print(f"  ! {item['error']}")
    blocks = item.get("changes") if item["status"] != "enabled" else []
    if item["status"] in ("enabled", "declined") and item.get("installed"):
        print("  Revoking would change:")
        blocks = item.get("removal") or []
    elif blocks:
        print("  Approving would change:")
    for block in blocks or []:
        for line in (block.get("diff") or "").splitlines():
            print(f"    {line}")
    print()


def cmd_consent(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    try:
        view = _get_json(base, "/api/config-consent", timeout=30)
    except OSError as e:
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    items = view.get("items") or []
    by_id = {i["id"]: i for i in items}
    action = args.action or "list"

    if action in ("list", "show"):
        if args.json:
            if action == "show":
                view = {"items": [by_id[i] for i in args.items if i in by_id]}
            print(json.dumps(view, indent=2))
            return 0
        chosen = items if action == "list" else [by_id[i] for i in args.items if i in by_id]
        unknown = [i for i in args.items if i not in by_id] if action == "show" else []
        for i in unknown:
            print(f"ccc: unknown item {i!r} (see `ccc consent`)", file=sys.stderr)
        for item in chosen:
            _print_consent_item(item, with_diff=(action == "show" or args.diff))
        if action == "list":
            pending = view.get("needs_review") or 0
            if pending:
                print(f"\n{pending} item(s) need your decision. "
                      "Details: ccc consent show <item>; then ccc consent approve|decline <item...|all>")
            print(f"Backups of every file CCC edits: {view.get('backups_dir')}")
        return 1 if unknown else 0

    targets = list(args.items)
    if not targets:
        print(f"ccc: consent {action} needs item ids or 'all'", file=sys.stderr)
        return 2
    if targets == ["all"]:
        if action == "approve":
            targets = [i["id"] for i in items if i.get("needs_review")]
        elif action == "decline":
            targets = [i["id"] for i in items if i.get("needs_review")]
        else:
            targets = [i["id"] for i in items]
        if not targets:
            print("nothing to do")
            return 0
    unknown = [t for t in targets if t not in by_id]
    if unknown:
        print(f"ccc: unknown item(s): {', '.join(unknown)} (see `ccc consent`)", file=sys.stderr)
        return 2
    if action == "revoke":
        # `revoke all` lets the server pick "everything CCC installed".
        ids = [] if list(args.items) == ["all"] else targets
        status, result = _post_json(base, "/api/config-consent/revoke", {"ids": ids, "via": "cli"})
    else:
        choice = "approve" if action == "approve" else "decline"
        status, result = _post_json(base, "/api/config-consent/decide",
                                    {"decisions": {t: choice for t in targets}, "via": "cli"})
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        for item_id, r in (result.get("results") or {}).items():
            print(f"{item_id:<32} {'ok' if r.get('ok') else 'FAILED: ' + str(r.get('error'))}")
        if result.get("error"):
            print(f"ccc: {result['error']}", file=sys.stderr)
    return 0 if result.get("ok") else 1


def _print_continue_from_result(result, status, args):
    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1
    if not result.get("ok"):
        print(f"ccc: continue-from failed: {result.get('error') or f'HTTP {status}'}",
              file=sys.stderr)
        return 1
    ctx_k = result.get("context_tokens")
    ctx_note = f", {ctx_k:,} tokens" if ctx_k else ""
    if result.get("dry_run"):
        print(
            f"[dry-run] would continue {result['continue_from']} "
            f"(latest: {result['latest_session_id']}{ctx_note}) as a new "
            f"{result['engine']} session"
        )
        if result.get("report_to"):
            print(f"  reports to: {result['report_to']}")
        return 0
    print(
        f"continued {result['continue_from']} (latest: {result['latest_session_id']}) "
        f"-> new session {result['new_session_id']}"
    )
    rebound = result.get("rebound") or []
    if rebound:
        print(f"  rebound {len(rebound)} report route(s) from the old chain")
    print("track it: ccc sessions")
    return 0


def _spawn_continue_from(base, sid, prompt, args):
    payload = {"continue_from": sid, "prompt": prompt}
    if getattr(args, "model", None):
        payload["model"] = args.model
    if getattr(args, "effort", None):
        payload["effort"] = args.effort
    if getattr(args, "report_to", None):
        payload["report_to"] = args.report_to
    if getattr(args, "dry_run", False):
        payload["dry_run"] = True
    try:
        status, result = _post_json(base, "/api/sessions/spawn-continue-from", payload)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    return _print_continue_from_result(result, status, args)


def cmd_spawn(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    prompt = " ".join(args.prompt).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if args.continue_from:
        sid, err = _resolve_target(base, args.continue_from)
        if err:
            print(err, file=sys.stderr)
            return 1
        return _spawn_continue_from(base, sid, prompt, args)
    if not prompt:
        print("ccc spawn: missing prompt (pass it as an argument or pipe it on stdin)",
              file=sys.stderr)
        return 2
    payload = {"prompt": prompt}
    if args.engine:
        payload["engine"] = args.engine
    if args.model:
        payload["model"] = args.model
    if args.effort:
        payload["reasoning_effort"] = args.effort
    if args.name:
        payload["name"] = args.name
    if args.runtime:
        payload["runtime"] = args.runtime
    # The endpoint is repo-scoped (explicit cwd/repo_path required). A CLI's
    # natural scope is the directory it was invoked from.
    payload["cwd"] = args.cwd or os.getcwd()
    if args.worktree:
        payload["worktree"] = True
    if args.confirm_blocked_model:
        payload["confirm_blocked_model"] = True
    if args.task_key:
        payload["task_key"] = args.task_key
    if args.dedupe:
        payload["dedupe"] = True
    if args.report_to:
        payload["report_to"] = args.report_to
    elif os.environ.get("CLAUDE_CODE_SESSION_ID"):
        # Best-effort attribution: invoked from inside a Claude Code session
        # (interactive or headless) with no explicit --report-to, so default
        # to that session rather than leaving the spawn's provenance blank.
        payload["report_to"] = os.environ["CLAUDE_CODE_SESSION_ID"]
    if not payload.get("report_to"):
        # No env to read (Codex, Gemini, a plain shell). Hand the server this
        # process's ancestry so it can resolve the calling session itself; it
        # only sets a parent when the match is unambiguous, and a miss leaves
        # the spawn exactly as un-attributed as it is today.
        chain = _caller_pid_chain()
        if chain:
            payload["caller_pids"] = chain
            payload["caller_cwd"] = payload.get("cwd") or os.getcwd()
    try:
        status, result = _post_json(base, "/api/sessions/spawn", payload)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1
    if not result.get("ok"):
        print(f"ccc: spawn failed: {result.get('error') or f'HTTP {status}'}", file=sys.stderr)
        if result.get("supported_engines"):
            print(f"  engines: {', '.join(result['supported_engines'])}", file=sys.stderr)
        if result.get("known_codex_models"):
            print(f"  known codex models: {', '.join(result['known_codex_models'])}",
                  file=sys.stderr)
        print("  see `ccc models` for valid --engine/--model/--effort values",
              file=sys.stderr)
        return 1
    sid = result.get("session_id") or ""
    pid = result.get("pid")
    engine = result.get("engine") or args.engine or "claude"
    bits = []
    if args.name:
        bits.append(f"name={args.name!r}")
    if args.model:
        bits.append(f"model={args.model}")
    if args.effort:
        bits.append(f"effort={args.effort}")
    if result.get("runtime") == "free":
        bits.append("runtime=free ($0)")
    ident = f"session {sid}" if sid else (f"pid {pid}" if pid else "session")
    suffix = f"  ({', '.join(bits)})" if bits else ""
    if result.get("existing"):
        verb = "finished lane already exists" if result.get("finished") \
            else "lane already exists"
        print(f"{verb} for this dedupe key: {engine} {ident}{suffix}")
        if result.get("report_back") == "original_dispatcher":
            print("note: completion reports go to the lane's original "
                  "dispatcher, not this spawn")
    else:
        print(f"spawned {engine} {ident}{suffix}")
    print("track it: ccc sessions")
    return 0


def cmd_brain(args):
    """Passthrough to an optional private 'brain' plugin (MEMORY-1). CCC
    itself has no idea what the plugin does -- it just execs
    <plugin_path>/bin/brain with whatever args followed `ccc brain`,
    inheriting this process's stdio, so the plugin's own CLI runs exactly as
    if it had been invoked directly. Config-only; no running CCC server
    required. See ccc_server/brain_hook.py for the config file format."""
    try:
        with open(BRAIN_CONFIG_FILE) as f:
            config = json.load(f)
    except OSError:
        print(f"ccc brain: no plugin configured ({BRAIN_CONFIG_FILE} not found)",
              file=sys.stderr)
        return 1
    except ValueError as e:
        print(f"ccc brain: {BRAIN_CONFIG_FILE} is not valid JSON ({e})", file=sys.stderr)
        return 1
    plugin_path = (config or {}).get("plugin_path")
    if not plugin_path:
        print(f"ccc brain: {BRAIN_CONFIG_FILE} has no plugin_path set", file=sys.stderr)
        return 1
    exe = os.path.join(os.path.expanduser(str(plugin_path)), "bin", "brain")
    if not os.path.isfile(exe) or not os.access(exe, os.X_OK):
        print(f"ccc brain: plugin executable not found or not executable ({exe})",
              file=sys.stderr)
        return 1
    os.execv(exe, [exe] + args.args)


def _wt_argv():
    """`CCC_WT_CMD` (shell-split) wins; else a `wt` on PATH or a usual prefix.
    None when `wt` isn't installed -- callers treat that as "skip, wt is
    optional"."""
    override = os.environ.get("CCC_WT_CMD", "").strip()
    if override:
        return shlex.split(override)
    for cand in ("wt", "/opt/homebrew/bin/wt", "/usr/local/bin/wt",
                 os.path.join(os.path.expanduser("~"), ".local", "bin", "wt")):
        found = shutil.which(cand) if "/" not in cand else (cand if os.access(cand, os.X_OK) else None)
        if found:
            return [found]
    return None


def _wt_json(wt, args, timeout=6):
    try:
        out = subprocess.run(wt + args, capture_output=True, text=True, timeout=timeout)
        return json.loads(out.stdout or "null")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def _rebind_wt_counts(old_sid):
    """Best-effort counts of what else now routes to NEW once CCC has
    recorded the forward `ccc rebind-report-to --from OLD` just made: open
    WatchTower tickets OLD submitted (across every queue), and queue
    subscriptions with OLD as their target. None when `wt` isn't installed or
    any lookup fails -- this is informational only, never blocking on the
    report-route rebind itself."""
    wt = _wt_argv()
    if not wt:
        return None
    queues = _wt_json(wt, ["status", "--json"])
    if not isinstance(queues, list):
        return None
    names = [q.get("queue") for q in queues if isinstance(q, dict) and q.get("queue")]
    open_tickets = 0
    subscriptions = 0
    for name in names:
        tickets = _wt_json(wt, ["ls", "-q", name, "--status", "active", "--json"])
        if isinstance(tickets, list):
            open_tickets += sum(
                1 for t in tickets if isinstance(t, dict) and t.get("submitter") == old_sid
            )
        subs = _wt_json(wt, ["subscribe", name, "--json"])
        if isinstance(subs, list):
            subscriptions += sum(1 for s in subs if s == old_sid)
    return {"open_tickets": open_tickets, "queue_subscriptions": subscriptions}


def cmd_rebind_report_to(args):
    base = _resolve_server(args.server)
    if not base:
        print(
            "ccc: no server found — is CCC running? "
            f"(looked for --server, $CCC_SERVER, {PORT_FILE})",
            file=sys.stderr,
        )
        return 1
    new_sid, err = _resolve_target(base, args.new_report_to)
    if err:
        print(err, file=sys.stderr)
        return 1
    payload = {"report_to": new_sid}
    if args.from_report_to:
        old_sid, err = _resolve_target(base, args.from_report_to)
        if err:
            print(err, file=sys.stderr)
            return 1
        payload["from_report_to"] = old_sid
    if args.child:
        if args.child.startswith("rr_"):
            payload["route_id"] = args.child
        else:
            child_sid, err = _resolve_target(base, args.child)
            if err:
                print(err, file=sys.stderr)
                return 1
            payload["child_session_id"] = child_sid
    if len(payload) == 1:
        print("ccc rebind-report-to: pass --child and/or --from", file=sys.stderr)
        return 2
    try:
        status, result = _post_json(base, "/api/report-routes/rebind", payload)
    except OSError as e:  # URLError, plus raw TimeoutError from mid-read stalls
        print(f"ccc: cannot reach CCC at {base} ({e}) — is CCC running?", file=sys.stderr)
        return 1
    if not result.get("ok"):
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"ccc: rebind failed: {result.get('error') or f'HTTP {status}'}", file=sys.stderr)
        return 1
    wt_counts = _rebind_wt_counts(old_sid) if args.from_report_to else None
    if args.json:
        if wt_counts is not None:
            result["wt_counts"] = wt_counts
        print(json.dumps(result, indent=2))
        return 0
    moved = result.get("rebound") or []
    parts = [f"{len(moved)} child report route(s)"]
    if wt_counts is not None:
        parts.append(f"{wt_counts['open_tickets']} open ticket(s)")
        parts.append(f"{wt_counts['queue_subscriptions']} queue subscription(s)")
    print(f"rebound {', '.join(parts)} to {new_sid}")
    if not moved:
        print("  (children spawned before rebindable routes report to their "
              "original sid; message them with `ccc send` instead)")
    return 0


def _fmt_rel(ts, now=None):
    """'3m ago' / 'in 2h05m' for an ISO timestamp; '-' when absent."""
    dt = _parse_iso(ts)
    if dt is None:
        return "-"
    now = now or datetime.now(timezone.utc)
    delta = (dt - now).total_seconds()
    return f"in {_fmt_age(delta)}" if delta >= 0 else f"{_fmt_age(-delta)} ago"


def _job_line(job, now=None):
    outcome = " ".join(str(job.get("outcome") or "").split())
    if len(outcome) > 70:
        outcome = outcome[:69] + "…"
    return (
        f"{str(job.get('host') or '?'):<7} {str(job.get('name') or '?'):<40} "
        f"{str(job.get('status') or '?'):<9} last {_fmt_rel(job.get('last_run_at'), now):<10} "
        f"next {_fmt_rel(job.get('next_run_at'), now):<10} {outcome}"
    ).rstrip()


